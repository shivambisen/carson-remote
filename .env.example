# Copy to .env and fill in. Never commit .env.
# All carson-server settings are read from CARSON_* environment variables.

CARSON_ADDR=:8080
CARSON_PUBLIC_URL=http://localhost:8080
# Other https addresses of this server, comma-separated, for networks that block the main domain
# (e.g. the host's own onrender.com name). Each needs its own OAuth callback registered too.
# CARSON_ALT_PUBLIC_URLS=https://example.onrender.com
CARSON_DB_PATH=./data/carson.db
# PostgreSQL instead of the SQLite file (e.g. a free Neon database). Keep it secret.
# CARSON_DATABASE_URL=postgresql://user:password@host/db?sslmode=require
CARSON_LOG_LEVEL=info
# Enables the dev-only email login. Must be false in production.
CARSON_DEV=true

# Shared with coturn (static-auth-secret) to mint time-limited TURN credentials.
CARSON_TURN_SECRET=change-me-dev-only
CARSON_TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
CARSON_STUN_URLS=stun:localhost:3478
# Lifetime of per-session TURN credentials (coturn REST API scheme). Default 6h.
CARSON_TURN_TTL=6h

# Extra browser origins allowed to make signed-in requests (e.g. the Vite dev server).
CARSON_ALLOWED_ORIGINS=
# Set true behind Caddy/another reverse proxy so rate limits and audit see real client IPs.
CARSON_TRUST_PROXY=false
# Serve the built viewer from this directory (the Docker image sets /web).
CARSON_WEB_DIR=

# Sign-in providers. Callback URLs to register:
#   Google: <CARSON_PUBLIC_URL>/auth/google/callback
#   GitHub: <CARSON_PUBLIC_URL>/auth/github/callback
# At least one is required unless CARSON_DEV=true.
CARSON_GOOGLE_CLIENT_ID=
CARSON_GOOGLE_CLIENT_SECRET=
CARSON_GITHUB_CLIENT_ID=
CARSON_GITHUB_CLIENT_SECRET=

# One-time purchase via Razorpay (empty = no paywall). Price in paise (9900 = ₹99).
# Webhook URL to register in Razorpay: <CARSON_PUBLIC_URL>/billing/razorpay/webhook
CARSON_RAZORPAY_KEY_ID=
CARSON_RAZORPAY_KEY_SECRET=
CARSON_RAZORPAY_WEBHOOK_SECRET=
CARSON_PRICE_PAISE=9900

# Cloudflare TURN relay (free allowance ~1,000 GB/month), for networks that block direct
# connections. Create a TURN key in the Cloudflare dashboard: Realtime → TURN Server.
CARSON_CLOUDFLARE_TURN_KEY_ID=
CARSON_CLOUDFLARE_TURN_TOKEN=
